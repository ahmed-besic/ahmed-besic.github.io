---
import { translations } from '../i18n';

interface Props {
  title: string;
}

const { title } = Astro.props;
const metaDescription = translations.en['meta.description'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { languages, translations } from '../i18n';

      const defaultLang = 'en';
      const storageKey = 'portfolio-lang';

      const getInitialLanguage = () => {
        const saved = localStorage.getItem(storageKey);
        if (saved && languages.includes(saved)) return saved;

        const browserLang = navigator.language.toLowerCase();
        if (browserLang.startsWith('de')) return 'de';
        if (browserLang.startsWith('bs')) return 'bs';
        return defaultLang;
      };

      const applyLanguage = (lang) => {
        const dict = translations[lang] || translations[defaultLang];
        document.documentElement.lang = lang;
        localStorage.setItem(storageKey, lang);

        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const value = dict[key] || translations[defaultLang][key];
          if (value) el.textContent = value;
        });

        document.querySelectorAll('[data-i18n-aria-label]').forEach((el) => {
          const key = el.getAttribute('data-i18n-aria-label');
          if (!key) return;
          const value = dict[key] || translations[defaultLang][key];
          if (value) el.setAttribute('aria-label', value);
        });

        const metaEl = document.querySelector('meta[name=\"description\"]');
        if (metaEl) {
          metaEl.setAttribute('content', dict['meta.description'] || translations[defaultLang]['meta.description']);
        }
        document.title = dict['meta.title'] || translations[defaultLang]['meta.title'];

        document.querySelectorAll('[data-lang-button]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const isActive = button.dataset.lang === lang;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        const buttons = Array.from(document.querySelectorAll('[data-lang-button]')).filter(
          (button) => button instanceof HTMLButtonElement
        ) as HTMLButtonElement[];
        const activeIndex = Math.max(0, buttons.findIndex((button) => button.dataset.lang === lang));
        const indicator = document.querySelector('[data-lang-indicator]');
        if (indicator instanceof HTMLElement) {
          indicator.style.transform = `translateX(${activeIndex * 100}%)`;
        }
      };

      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      const resetToHero = () => {
        if (window.location.hash === '#projects') {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }

        window.scrollTo(0, 0);
      };

      if (!window.location.hash || window.location.hash === '#projects') {
        resetToHero();
        window.addEventListener('load', () => {
          requestAnimationFrame(resetToHero);
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));

      const initialLang = getInitialLanguage();
      applyLanguage(initialLang);

      document.querySelectorAll('[data-lang-button]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const value = button.dataset.lang;
          if (value) applyLanguage(value);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
