---
const experiences = [
  {
    roleI18n: 'experience.jobs.1.role',
    role: 'Full-Stack Developer (Freelance)',
    companyI18n: 'experience.jobs.1.company',
    company: 'Self-Employed',
    periodI18n: 'experience.jobs.1.period',
    period: 'Feb 2023 – Present',
    items: [
      { i18n: 'experience.jobs.1.item.1', text: 'Developed a CBAM compliance SaaS using React, Next.js, and Convex, automating EU Carbon Border Adjustment reporting workflows for Bosnian industrial companies.' },
      { i18n: 'experience.jobs.1.item.2', text: 'Engineered a comprehensive e-learning portal featuring document tracking, dynamic lecturer profiles, and live video classrooms using React and Convex.' },
      { i18n: 'experience.jobs.1.item.3', text: 'Built and deployed a real-time event photo-sharing application for high-scale events, enabling seamless guest uploads and instant gallery synchronization.' },
    ],
  },
  {
    roleI18n: 'experience.jobs.2.role',
    role: 'Software & E-Commerce Developer',
    companyI18n: 'experience.jobs.2.company',
    company: 'Universals101 oHG (Munich, Germany)',
    periodI18n: 'experience.jobs.2.period',
    period: 'Sep 2020 – Oct 2025',
    items: [
      { i18n: 'experience.jobs.2.item.1', text: 'Architected a real-time 3D product configurator with Three.js, enabling live sofa customization which significantly increased conversion rates for international customers.' },
      { i18n: 'experience.jobs.2.item.2', text: 'Automated Amazon PPC campaign management end-to-end using custom Python scripts, eliminating manual bidding overhead and optimizing data-driven ROI.' },
      { i18n: 'experience.jobs.2.item.3', text: 'Managed the complete digital ecosystem for multiple brands across Shopify and WordPress, collaborating with stakeholders to translate commercial goals into technical storefront solutions.' },
    ],
  },
];

const keyProjects = [
  {
    titleI18n: 'experience.key.1.title',
    title: "Gesture Recognition (Bachelor's Thesis)",
    contextI18n: 'experience.key.1.context',
    context: 'TU Graz',
    periodI18n: 'experience.key.1.period',
    period: '2025',
    descI18n: 'experience.key.1.desc',
    description:
      'Designed and trained deep neural network models for real-time hand gesture classification, achieving high accuracy on benchmark datasets using Python and Machine Learning frameworks.',
  },
  {
    titleI18n: 'experience.key.2.title',
    title: 'Azure Data Pipeline',
    contextI18n: 'experience.key.2.context',
    context: 'Professional Project',
    periodI18n: 'experience.key.2.period',
    period: '2024',
    descI18n: 'experience.key.2.desc',
    description:
      'Built an end-to-end ETL pipeline using Azure Data Factory, Azure Functions, and Snowflake, automating data ingestion and transformation with dbt for analytics reporting.',
  },
];

const education = [
  {
    degreeI18n: 'experience.edu.1.degree',
    degree: 'B.Sc. Computer Science',
    schoolI18n: 'experience.edu.1.school',
    school: 'Graz University of Technology (TU Graz), Austria',
    periodI18n: 'experience.edu.1.period',
    period: '2019 – 2025',
    focusI18n: 'experience.edu.1.focus',
    focus: 'Algorithms, Machine Learning, Software Engineering, Distributed Systems.',
  },
  {
    degreeI18n: 'experience.edu.2.degree',
    degree: 'High School Diploma',
    schoolI18n: 'experience.edu.2.school',
    school: 'Gymnasium "Dr. Mustafa Kamarić", Gračanica',
    periodI18n: 'experience.edu.2.period',
    period: 'Graduated 2019',
    focusI18n: 'experience.edu.2.focus',
    focus: 'Advanced focus: Programming (C/C++), Mathematics, and Physics.',
  },
];
---

<section id="experience">
  <div class="container fade-in">
    <p class="section-label" data-i18n="experience.label">Experience</p>
    <h2 class="section-title" data-i18n="experience.title">Where I've worked</h2>
    <div class="timeline">
      {experiences.map((exp, i) => (
        <div class="timeline-item">
          <div class="timeline-marker">
            <span class="timeline-dot" />
            {i < experiences.length - 1 && <span class="timeline-line" />}
          </div>
          <div class="timeline-content">
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role" data-i18n={exp.roleI18n}>{exp.role}</h3>
                <p class="timeline-company" data-i18n={exp.companyI18n}>{exp.company}</p>
              </div>
              <span class="timeline-period" data-i18n={exp.periodI18n}>{exp.period}</span>
            </div>
            <ul class="timeline-items">
              {exp.items.map((item) => (
                <li data-i18n={item.i18n}>{item.text}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <section class="timeline-section" aria-labelledby="key-projects-title">
      <p class="section-label" data-i18n="experience.keyProjects">Key Projects</p>
      <h3 id="key-projects-title" class="timeline-section-title" data-i18n="experience.keyProjectsTitle">Research & data work</h3>
      <div class="timeline compact-timeline">
        {keyProjects.map((project, i) => (
          <div class="timeline-item">
            <div class="timeline-marker">
              <span class="timeline-dot" />
              {i < keyProjects.length - 1 && <span class="timeline-line" />}
            </div>
            <div class="timeline-content">
              <div class="timeline-header">
                <div>
                  <h4 class="timeline-role" data-i18n={project.titleI18n}>{project.title}</h4>
                  <p class="timeline-company" data-i18n={project.contextI18n}>{project.context}</p>
                </div>
                <span class="timeline-period" data-i18n={project.periodI18n}>{project.period}</span>
              </div>
              <p class="timeline-desc" data-i18n={project.descI18n}>{project.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="timeline-section" aria-labelledby="education-title">
      <p class="section-label" data-i18n="experience.education">Education</p>
      <h3 id="education-title" class="timeline-section-title" data-i18n="experience.educationTitle">Academic background</h3>
      <div class="timeline compact-timeline">
        {education.map((item, i) => (
          <div class="timeline-item">
            <div class="timeline-marker">
              <span class="timeline-dot" />
              {i < education.length - 1 && <span class="timeline-line" />}
            </div>
            <div class="timeline-content">
              <div class="timeline-header">
                <div>
                  <h4 class="timeline-role" data-i18n={item.degreeI18n}>{item.degree}</h4>
                  <p class="timeline-company" data-i18n={item.schoolI18n}>{item.school}</p>
                </div>
                <span class="timeline-period" data-i18n={item.periodI18n}>{item.period}</span>
              </div>
              <p class="timeline-desc" data-i18n={item.focusI18n}>{item.focus}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</section>

<style>
  #experience {
    border-top: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1rem;
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: 0.3rem;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin-top: 0.5rem;
  }

  .timeline-content {
    padding-bottom: 2.5rem;
    flex: 1;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .timeline-role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .timeline-company {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .timeline-period {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    padding: 0.25rem 0.65rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    flex-shrink: 0;
  }

  .timeline-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-items li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
    padding-left: 1.25rem;
    position: relative;
  }

  .timeline-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .timeline-section {
    margin-top: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-light);
  }

  .timeline-section-title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--text-primary);
    margin-bottom: 0.7rem;
  }

  .compact-timeline {
    margin-top: 0;
  }

  .compact-timeline .timeline-content {
    padding-bottom: 1.15rem;
  }

  .timeline-section + .timeline-section {
    padding-top: 0.75rem;
  }

  .timeline-section + .timeline-section .timeline-section-title {
    margin-bottom: 0.55rem;
  }

  .timeline-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    #experience {
      padding-bottom: 2.75rem;
    }

    .timeline-header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .timeline-item {
      gap: 1rem;
    }

    .timeline-section {
      padding-top: 1rem;
    }

    .timeline-section + .timeline-section {
      padding-top: 0.65rem;
    }
  }
</style>
