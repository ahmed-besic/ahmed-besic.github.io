---
const links = [
  { label: 'Email', href: 'mailto:ahmed.besic2000@gmail.com', value: 'ahmed.besic2000@gmail.com', icon: 'https://svgl.app/library/gmail.svg' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/ahmed-besic', value: 'ahmed-besic', icon: 'https://svgl.app/library/linkedin.svg' },
  { label: 'GitHub', href: 'https://github.com/ahmed-besic', value: 'ahmed-besic', icon: 'https://svgl.app/library/github_dark.svg' },
];
---

<section id="contact">
  <div class="container fade-in">
    <p class="section-label" data-i18n="contact.label">Contact</p>
    <h2 class="section-title" data-i18n="contact.title">Let's work together</h2>
    <p class="section-subtitle" data-i18n="contact.subtitle">
      Have a project in mind or want to collaborate? Feel free to reach out.
    </p>
    <div class="contact-links">
      {links.map((link) => (
        <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="contact-card">
          {link.icon && <img src={link.icon} alt="" class="contact-icon" width="20" height="20" loading="lazy" />}
          <div class="contact-text">
            <span class="contact-label">{link.label}</span>
            <span class="contact-value">{link.value}</span>
          </div>
          <span class="contact-arrow">&#8599;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  #contact {
    border-top: 1px solid var(--border);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
    max-width: 500px;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: all var(--transition);
    color: var(--text-primary);
  }

  .contact-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-light);
    color: var(--text-primary);
  }

  .contact-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .contact-text {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .contact-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    min-width: 70px;
  }

  .contact-value {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .contact-arrow {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition);
  }

  .contact-card:hover .contact-arrow {
    color: var(--accent);
  }
</style>
