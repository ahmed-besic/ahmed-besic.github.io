---
const projects = [
  {
    title: 'CBAMReady',
    typeI18n: 'projects.type.cbam',
    descI18n: 'projects.desc.cbam',
    description: 'CBAM compliance SaaS for manufacturers exporting to the EU. Track embedded emissions, manage product passports, and prepare quarterly reporting in one system.',
    url: 'https://cbam-ba.app/',
    tags: ['React', 'Astro', 'Convex', 'SaaS'],
    type: 'Compliance platform',
  },
  {
    title: 'Virtual Classroom',
    typeI18n: 'projects.type.classroom',
    descI18n: 'projects.desc.classroom',
    description: 'Live teaching platform with HD video, collaborative whiteboard, PDF worksheet overlays, and gamification tools built for online educators.',
    url: 'https://work-classroom.vercel.app/',
    tags: ['React', 'Convex', 'Daily.co'],
    type: 'Education tool',
  },
  {
    title: 'Svadba Galerija',
    typeI18n: 'projects.type.svadba',
    descI18n: 'projects.desc.svadba',
    description: 'Real-time wedding photo-sharing app. Guests upload photos that instantly sync to a shared gallery for seamless event coverage.',
    url: 'https://svadba-upload.vercel.app/',
    tags: ['React', 'Convex', 'Real-time'],
    type: 'Event gallery',
  },
  {
    title: 'Trivia Night',
    typeI18n: 'projects.type.trivia',
    descI18n: 'projects.desc.trivia',
    description: 'Real-time multiplayer quiz game. Enter a code to join, or host your own game with live score tracking.',
    url: 'https://trivia-igra.vercel.app/',
    tags: ['React', 'WebSockets', 'Multiplayer'],
    type: 'Multiplayer game',
  },
  {
    title: 'Nacrtaj i Pogodi',
    typeI18n: 'projects.type.crtaj',
    descI18n: 'projects.desc.crtaj',
    description: 'Multiplayer drawing and guessing game for 2–8 players. Draw on mobile, guess in real-time.',
    url: 'https://crtaj.vercel.app/',
    tags: ['React', 'Canvas', 'Multiplayer'],
    type: 'Party game',
  },
  {
    title: 'ZenZone',
    typeI18n: 'projects.type.zen',
    descI18n: 'projects.desc.zen',
    description: 'Wellness and recovery platform providing a dedicated space for rest and recuperation resources.',
    url: 'https://zen-zone-besic.vercel.app/',
    tags: ['React', 'Next.js'],
    type: 'Wellness app',
  },
];
---

<section id="projects">
  <div class="container fade-in">
    <div class="projects-heading">
      <div>
        <p class="section-label" data-i18n="projects.label">Projects</p>
        <h2 class="section-title" data-i18n="projects.title">Things I've built</h2>
      </div>
      <p class="projects-intro" data-i18n="projects.intro">
        A selection of shipped apps across SaaS, education, real-time collaboration, and multiplayer experiences.
      </p>
    </div>
    <div class="projects-grid">
      {projects.map((project) => (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-card">
          <div class="project-top">
            <span class="project-type" data-i18n={project.typeI18n}>{project.type}</span>
            <span class="project-icon" aria-hidden="true">&#8599;</span>
          </div>
          <div class="project-header">
            <h3 class="project-title">{project.title}</h3>
          </div>
          <p class="project-desc" data-i18n={project.descI18n}>{project.description}</p>
          <div class="project-tags">
            {project.tags.map((tag) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  #projects {
    border-top: 1px solid var(--border);
  }

  .projects-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .projects-heading .section-title {
    margin-bottom: 0;
  }

  .projects-intro {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    perspective: 1000px;
  }

  .project-card {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --sheen-opacity: 0;
    --nx: 0;
    --ny: 0;
    position: relative;
    min-height: 270px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0) 12%),
      #0e0e0e;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
    transform: translateY(0) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 90ms linear, border-color 140ms ease, background 140ms ease, box-shadow 140ms ease;
    color: var(--text-primary);
  }

  .project-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 0% 0%, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.12) 28%, rgba(255, 255, 255, 0.04) 52%, transparent 74%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.05) 32%, transparent 62%);
    opacity: var(--sheen-opacity);
    transition: opacity 120ms ease;
    mix-blend-mode: normal;
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset calc(var(--nx) * 14px) calc(var(--ny) * 14px) 30px rgba(0, 0, 0, 0.56);
    opacity: 1;
    transition: box-shadow 90ms linear;
  }

  .project-card:hover {
    background: #111111;
    border-color: var(--border);
    transform: translateY(-5px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    color: var(--text-primary);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.2);
  }

  .project-card:hover::after {
    opacity: var(--sheen-opacity);
  }

  .project-card:hover::before {
    box-shadow: inset calc(var(--nx) * 14px) calc(var(--ny) * 14px) 30px rgba(0, 0, 0, 0.56);
  }

  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .project-type {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-header {
    display: flex;
    align-items: center;
    margin-bottom: 0.7rem;
  }

  .project-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.02);
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: all var(--transition);
  }

  .project-card:hover .project-icon {
    color: var(--accent);
    border-color: rgba(79, 156, 247, 0.35);
    background: var(--accent-dim);
    transform: translate(2px, -2px);
  }

  .project-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
    flex: 1;
    margin-bottom: 1rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .project-tag {
    --pill-depth-x: 0px;
    --pill-depth-y: 0px;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.22rem 0.55rem;
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.045);
    border-radius: 100px;
    transform: translate3d(var(--pill-depth-x), var(--pill-depth-y), -3px);
    box-shadow:
      inset calc(var(--nx) * -8px) calc(var(--ny) * -8px) 10px rgba(255, 255, 255, 0.13),
      inset calc(var(--nx) * 8px) calc(var(--ny) * 8px) 13px rgba(0, 0, 0, 0.62);
    transition: transform 90ms linear, box-shadow 140ms ease;
  }

  @media (max-width: 768px) {
    .projects-heading {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: auto;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-grid {
      perspective: none;
    }

    .project-card {
      transform: none;
      transition: border-color 220ms ease, background 220ms ease, box-shadow 220ms ease;
    }

    .project-card:hover {
      transform: translateY(-3px);
    }

    .project-card::after {
      display: none;
    }

    .project-card::before {
      display: none;
    }

    .project-tag {
      transform: none;
      transition: box-shadow 140ms ease;
    }
  }
</style>

<script>
  const setupProjectTilt = () => {
    const cards = document.querySelectorAll('.project-card');
    const canTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!canTilt || reducedMotion) return;

    cards.forEach((card) => {
      if (card.dataset.tiltReady === 'true') return;
      card.dataset.tiltReady = 'true';

      let frame = 0;

      const updateTilt = (event) => {
        const rect = card.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const px = x / rect.width;
        const py = y / rect.height;
        const rotateY = (px - 0.5) * 14;
        const rotateX = (0.5 - py) * 14;

        card.style.setProperty('--tilt-x', `${rotateX.toFixed(2)}deg`);
        card.style.setProperty('--tilt-y', `${rotateY.toFixed(2)}deg`);
        const nx = Math.max(-1, Math.min(1, rotateY / 14));
        const ny = Math.max(-1, Math.min(1, -rotateX / 14));
        const topLeftTilt = Math.max(0.4, (-nx + -ny) * 2.2);
        const tiltStrength = Math.min(1, (Math.abs(rotateX) + Math.abs(rotateY)) / 30);
        const sheen = Math.min(0.58, topLeftTilt * tiltStrength * 1.9);
        card.style.setProperty('--sheen-opacity', sheen.toFixed(3));
        card.style.setProperty('--nx', nx.toFixed(3));
        card.style.setProperty('--ny', ny.toFixed(3));
        card.style.setProperty('--pill-depth-x', `${(-rotateY * 0.6).toFixed(2)}px`);
        card.style.setProperty('--pill-depth-y', `${(rotateX * 0.6).toFixed(2)}px`);
      };

      const onMove = (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => updateTilt(event));
      };

      const onLeave = () => {
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
        card.style.setProperty('--sheen-opacity', '0');
        card.style.setProperty('--nx', '0');
        card.style.setProperty('--ny', '0');
        card.style.setProperty('--pill-depth-x', '0px');
        card.style.setProperty('--pill-depth-y', '0px');
      };

      card.addEventListener('mousemove', onMove);
      card.addEventListener('mouseleave', onLeave);
      card.addEventListener('pointermove', onMove);
      card.addEventListener('pointerleave', onLeave);
    });
  };

  setupProjectTilt();
  document.addEventListener('astro:page-load', setupProjectTilt);
</script>
